{
  "apiVersion": "v1",
  "kind": "manifest.plugin.airi.moeru.ai",
  "name": "lumi-diary",
  "permissions": {
    "apis": [
      {
        "key": "proj-airi:plugin-sdk:apis:client:tools:register",
        "actions": ["invoke"],
        "required": true
      }
    ],
    "resources": [
      {
        "key": "proj-airi:plugin-sdk:resources:tools",
        "actions": ["write"],
        "required": true
      },
      {
        "key": "local-filesystem:diary-directory",
        "actions": ["read", "write"],
        "required": true
      }
    ],
    "capabilities": []
  },
  "entrypoints": {
    "electron": "./index.mjs",
    "server": "./index.mjs"
  }
}
